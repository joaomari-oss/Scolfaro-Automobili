# .env.example — copie para .env e preencha os valores reais
# NUNCA commite o arquivo .env com valores reais

# Supabase (banco de dados)
# Obter em: https://supabase.com → Project Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Gemini 2.5 Flash — primário para valor de mercado
# Obter em: https://aistudio.google.com/apikey (gratuito, sem cartão)
VITE_GEMINI_API_KEY=

# Groq compound-beta — fallback para valor de mercado
# Obter em: https://console.groq.com/keys (gratuito, sem cartão)
VITE_GROQ_API_KEY=
