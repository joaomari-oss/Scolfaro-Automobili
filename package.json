  "homepage": "https://joaomari-oss.github.io/scolfaro-automobili/",
  "scripts": {
    "dev": "vite",
    "dev:full": "concurrently -n API,UI -c cyan,yellow \"npm run dev --prefix server\" \"vite\"",
