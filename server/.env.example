# server/.env.example — copie para server/.env e preencha os valores
# NUNCA commite o arquivo server/.env com valores reais

# Chave da API Google Gemini (obrigatório para IA funcionar)
# Obter em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...

# Chave da API Groq (fallback caso Gemini esteja indisponível)
# Obter gratuitamente em: https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# Token da API FIPE v2 (opcional, sem token = 500 req/dia; com token = 1000 req/dia)
# Registre-se gratuitamente em: https://fipe.online/register (login via GitHub)
# Header enviado: X-Subscription-Token
FIPE_API_TOKEN=

# Porta do servidor backend (padrão: 3001)
PORT=3001
