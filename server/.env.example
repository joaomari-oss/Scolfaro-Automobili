# server/.env.example — copie para server/.env e preencha os valores
# NUNCA commite o arquivo server/.env com valores reais

# Chave da API Anthropic (obrigatório para IA funcionar)
# Obter em: https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-api...

# Token da API FIPE (opcional, sem token = limite de 500 req/dia)
# Obter gratuitamente em: https://deividfortuna.github.io/fipe
FIPE_API_TOKEN=

# Porta do servidor backend (padrão: 3001)
PORT=3001
